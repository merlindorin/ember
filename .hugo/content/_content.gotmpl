{{- /* Builds the guide under /docs from the plain Markdown in ember/docs (mounted on assets/docs): the H1 is the title, a one- or two-digit NN- prefix the weight (a decision's NNNN- stays in its name), a README.md its folder's section page. A link alone on its line to a file in ../examples shows that file, and one to an example's folder shows how to run it. Each page also gets a Markdown copy with the code inlined, for "Copy page". */ -}}
{{- range resources.Match "docs/**.md" -}}
  {{- $source := strings.TrimPrefix "docs/" (strings.TrimPrefix "/" .Name) -}}
  {{- if or (not (hasPrefix $source "99-decisions/")) (findRE `^99-decisions/(\d{4}-[^/]+|README)\.md$` $source) -}}
  {{- $file := path.Base $source -}}
  {{- $dir := path.Dir $source -}}
  {{- $path := slice "docs" -}}
  {{- if ne $dir "." -}}
    {{- range split $dir "/" -}}
      {{- $path = $path | append (replaceRE `^\d{1,2}-` "" .) -}}
    {{- end -}}
  {{- end -}}
  {{- $kind := "section" -}}
  {{- $numbered := $dir -}}
  {{- if ne $file "README.md" -}}
    {{- $kind = "page" -}}
    {{- $numbered = $file -}}
    {{- $path = $path | append (replaceRE `^\d{1,2}-` "" (strings.TrimSuffix ".md" $file)) -}}
  {{- end -}}
  {{- $weight := 0 -}}
  {{- with findRESubmatch `^(\d+)-` (path.Base $numbered) 1 -}}
    {{- $weight = int (strings.TrimLeft "0" (index . 0 1) | default "0") -}}
  {{- end -}}
  {{- $title := index (findRESubmatch `(?m)^# (.+)$` .Content 1) 0 1 -}}
  {{- if not $title -}}
    {{- errorf "docs/%s: no # title on its first line" $source -}}
  {{- end -}}
  {{- $body := replaceRE `^# [^\n]*\n+` "" .Content 1 -}}
  {{- $markdown := $body -}}
  {{- range findRESubmatch `(?m)^\[[^\]\n]+\]\((?:\.\./)+examples/([\w-]+/[\w.-]+)\)$` $body -1 -}}
    {{- $code := resources.Get (printf "examples/%s" (index . 1)) -}}
    {{- if not $code -}}
      {{- errorf "docs/%s: no example file %s" $source (index . 1) -}}
    {{- end -}}
    {{- $lang := cond (eq (path.Ext (index . 1)) ".go") "go" "text" -}}
    {{- $body = replace $body (index . 0) (printf `{{< file "%s" >}}` (index . 1)) -}}
    {{- $markdown = replace $markdown (index . 0) (printf "`%s`:\n\n```%s\n%s\n```" (path.Base (index . 1)) $lang (strings.TrimRight "\n" $code.Content)) -}}
  {{- end -}}
  {{- range findRESubmatch `(?m)^\[[\w-]+\]\((?:\.\./)+examples/([\w-]+)/?\)$` $body -1 -}}
    {{- $run := printf "```sh\ngo run ./examples/%s\n```" (index . 1) -}}
    {{- with resources.Get (printf "examples/%s/output.txt" (index . 1)) -}}
      {{- $run = printf "%s\n\n```text\n%s\n```" $run (strings.TrimRight "\n" .Content) -}}
    {{- end -}}
    {{- $body = replace $body (index . 0) (printf `{{< run "%s" >}}` (index . 1)) -}}
    {{- $markdown = replace $markdown (index . 0) $run -}}
  {{- end -}}
  {{- range findRESubmatch "(?m)^```(?:sh)?\ngo run \\./examples/([\\w-]+)((?: -[\\w-]+ [\\w-]+)+)\n```$" $body -1 -}}
    {{- $args := delimit (apply (split (strings.TrimSpace (index . 2)) " ") "printf" "%q" ".") " " -}}
    {{- $body = replace $body (index . 0) (printf "%s\n\n{{< live %q %s >}}" (index . 0) (index . 1) $args) -}}
  {{- end -}}
  {{- $params := dict "source" $source "markdown" $markdown "editURL" (printf "%s/docs/%s" site.Params.edit $source) -}}
  {{- if eq $path (slice "docs" "decisions") -}}
    {{- $body = replaceRE `(?m)(?:^\|.*(?:\n|$))+` "\n{{< decisions >}}\n" $body 1 -}}
  {{- else if and (gt (len $path) 1) (eq (index $path 1) "decisions") -}}
    {{- $meta := index (findRE `^(?:- [A-Z]\w*: [^\n]*\n)+` $body 1) 0 -}}
    {{- range findRESubmatch `(?m)^- (\w+): (.+)$` $meta -}}
      {{- $params = merge $params (dict (lower (index . 1)) (index . 2)) -}}
    {{- end -}}
    {{- range slice "status" "date" "area" "owner" -}}
      {{- if not (index $params .) -}}
        {{- errorf "docs/%s: no %s in the list under the title" $source . -}}
      {{- end -}}
    {{- end -}}
    {{- $state := "" -}}
    {{- $rest := $params.status -}}
    {{- with findRESubmatch `^Superseded by \[(\d{4})\]\(([^)]+)\)` $params.status 1 -}}
      {{- $state = "superseded" -}}
      {{- $params = merge $params (dict "replacedBy" (index . 0 1) "replacedAt" (index . 0 2)) -}}
      {{- $rest = strings.TrimPrefix (index . 0 0) $rest -}}
    {{- else -}}
      {{- if hasPrefix $params.status "Accepted" -}}
        {{- $state = "accepted" -}}
        {{- $rest = strings.TrimPrefix "Accepted" $rest -}}
      {{- else -}}
        {{- errorf "docs/%s: status %q is neither Accepted nor Superseded by [NNNN](…)" $source $params.status -}}
      {{- end -}}
    {{- end -}}
    {{- $note := replaceRE `^\((.*)\)$` "$1" (replaceRE `^[;,]?\s*` "" $rest) -}}
    {{- $params = merge $params (dict "state" $state "note" $note "number" (index (split $file "-") 0) "date" (time.AsTime $params.date)) -}}
    {{- $body = printf "{{< decision >}}\n\n%s" (strings.TrimLeft "\n" (strings.TrimPrefix $meta $body)) -}}
  {{- end -}}
  {{- $.AddPage (dict
    "kind" $kind
    "path" (delimit $path "/")
    "title" $title
    "weight" $weight
    "params" $params
    "content" (dict "mediaType" "text/markdown" "value" $body)
  ) -}}
  {{- end -}}
{{- end -}}
